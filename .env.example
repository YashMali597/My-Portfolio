# ---------------------------------------------------------------------------
# Agent model layer (lib/agent/models.ts)
#
# NEVER put a key anywhere but this file (or your host's env settings).
# lib/agent/config.ts reads keys from the environment only — the URLs in that
# file are help text printed in error messages, not a place for secrets.
# ---------------------------------------------------------------------------

# Google AI Studio key — powers the Gemini generation model used for answer
# synthesis and tool-use reasoning.
# Generate a free key at: https://aistudio.google.com/apikey
#
# NOTE: the free tier allows only ~20 generateContent requests PER DAY per
# model. That is enough to try the site, not enough to run the eval suite.
GOOGLE_API_KEY=

# Groq key — powers the low-latency router model.
# Generate a free key at: https://console.groq.com/keys
#
# NOTE: the free tier is ~8,000 tokens per minute. The eval paces itself
# accordingly (see `npm run eval -- --delay`).
GROQ_API_KEY=

# Embeddings run locally via @xenova/transformers (Xenova/all-MiniLM-L6-v2)
# and need no API key. See lib/knowledge/embeddings.ts for the one-line swap
# to Google's hosted text-embedding-004 if you'd rather not run a local model.

# ---------------------------------------------------------------------------
# Optional model overrides
#
# Model ids move — llama-3.1-8b-instant and gemini-2.0-flash were both retired
# during development. These let you repoint without editing code:
#   GET https://api.groq.com/openai/v1/models   lists what Groq serves now.
#   Gemini's 404 message names its own replacement.
#
# They also exist so the eval can run generation on whichever provider has
# quota headroom. Whichever models a run used are recorded in
# eval/results.json so published numbers can't be misattributed.
# ---------------------------------------------------------------------------

# "google" (default) or "groq"
# GENERATION_PROVIDER=groq
# GENERATION_MODEL_ID=openai/gpt-oss-120b
# ROUTER_MODEL_ID=openai/gpt-oss-20b

# Model used by the eval's grounding judge. Prefer a DIFFERENT model from the
# one under test — a model grading its own output is a weak check.
# JUDGE_MODEL_ID=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Superseded copilot stack (src/lib/rag/, api/copilot.ts)
# Unreachable from the UI since /api/agent replaced it. Still required by
# `npm run rag:build` and the old /api/copilot endpoint if you keep them.
# ---------------------------------------------------------------------------

# Claude API key used by the old Recruiter Copilot RAG backend.
ANTHROPIC_API_KEY=

# Voyage AI API key used to embed the old RAG corpus.
VOYAGE_API_KEY=
